{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "RUNTIME_PROFILE": "cloud",
    "CHAT_STORAGE_MODE": "browser",
    "NEXT_PUBLIC_CHAT_STORAGE_MODE": "browser",
    "LOCAL_MODELS_PRELOAD_ENABLED": "false",
    "LOCAL_MODELS_WARMUP_ENABLED": "false"
  },
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/_/backend/:path*",
      "destination": {
        "service": "backend",
        "path": "/:path*"
      },
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/:path*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
