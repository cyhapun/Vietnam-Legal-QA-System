# ==============================================================================
# VIETLAW AI - CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (MINIMAL CONFIGURATION TEMPLATE)
# ==============================================================================

# 1. ĐỊA CHỈ DỊCH VỤ WEB & HOST
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# 2. MÔ HÌNH SUY LUẬN LLM (GOOGLE AI STUDIO)
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
# Hỗ trợ 1 key hoặc nhiều key phân tách bằng dấu phẩy để tự động xoay vòng khi hết quota:
GOOGLE_API_KEYS=your_google_api_key_1,your_google_api_key_2
GOOGLE_MODEL=gemini-3.1-flash-lite
GOOGLE_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash

# 3. MÔ HÌNH EMBEDDING & RERANKING
# Chế độ chạy: 'local' (dùng mô hình fine-tuned miễn phí trên máy) hoặc 'serverless' (dùng API cloud)
RUNTIME_PROFILE=local
HUGGINGFACE_EMBEDDING_MODE=local
HUGGINGFACE_EMBEDDING_MODEL=../models/embedding/vietlaw-bge-m3-finetuned/best
PIPELINE_RERANKING=cross_encoder
RERANKER_MODEL=../models/reranking/vietlaw-bge-reranker-v2-m3-finetuned/selected

# (Cấu hình Serverless Cloud API - Dành cho môi trường Vercel hoặc tài khoản HF có credit)
# HUGGINGFACE_API_KEY=your_huggingface_api_key_here
# RUNTIME_PROFILE=serverless
# HUGGINGFACE_EMBEDDING_MODE=api
# HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-m3
# PIPELINE_RERANKING=embedding_similarity

# 4. CƠ SỞ DỮ LIỆU & VECTOR DB (SUPABASE & QDRANT CLOUD)
POSTGRES_DSN=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres?sslmode=require
QDRANT_URL=https://xxxx.eu-central-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=vietlaw_clauses
SEMANTIC_CACHE_COLLECTION=semantic_cache
CHAT_STORAGE_MODE=postgres
NEXT_PUBLIC_CHAT_STORAGE_MODE=postgres

# 5. THAM SỐ RAG PIPELINE
RETRIEVER_CANDIDATE_K=20
RETRIEVER_K=5
CONTEXT_TOKEN_BUDGET=6000
ENABLE_SEMANTIC_CACHE=true
