# VietLaw AI local environment template
# Backend runs directly in WSL.
# PostgreSQL and Qdrant run through local Docker Compose.
# Fine-tuned embedding and reranking models are loaded from the local filesystem.
# Copy this file to .env before running the application.

# ==================================================
# 1. Frontend and backend URLs
# ==================================================

APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000


# ==================================================
# 2. External provider keys
# ==================================================
# Leave these empty when running fully locally.
# End-user BYOK keys may still be configured separately in browser storage.

HUGGINGFACE_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

ENABLE_GOOGLE_FALLBACK=false
GOOGLE_FALLBACK_MODEL=gemini-3.1-flash-lite
GOOGLE_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/


# ==================================================
# 3. Fine-tuned local embedding
# ==================================================
# The query is embedded by the fine-tuned model on this machine.
# No Hugging Face inference API is used.
#
# This absolute path is for the current WSL project location.
# Change it if the repository is moved.

EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODE=local
HUGGINGFACE_EMBEDDING_MODEL=/models/embedding/vietlaw-bge-m3-finetuned/best

EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=1024
EMBEDDING_NORMALIZE=true

# Prevent Transformers/SentenceTransformer from downloading files.
LOCAL_MODELS_OFFLINE=true

# These retry values mainly apply to batch operations.
EMBEDDING_MAX_RETRIES=3
EMBEDDING_SLEEP_BETWEEN_BATCHES=5
EMBEDDING_RETRY_BASE_WAIT=15


# ==================================================
# 4. Local Ollama
# ==================================================
# Used for local answer generation when INFERENCE_STRATEGY=local_first.
# OLLAMA_EMBEDDING_MODEL is not used by the main retrieval pipeline because
# query embedding is handled by the fine-tuned model configured above.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_TIMEOUT=300


# ==================================================
# 5. Local storage
# ==================================================
# PostgreSQL is exposed by Docker on host port 15432.
# Qdrant is exposed by Docker on host port 6333.

STORAGE_BACKEND=qdrant_postgres

POSTGRES_DSN=postgresql://postgres:postgres@localhost:15432/vietlaw

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# This must point to a COMPLETE local collection embedded by the same
# fine-tuned embedding model.
#
# Do not point runtime to partial migration collections such as collections
# containing only 64 or 384 points.
QDRANT_COLLECTION=vietlaw_clauses

# Keep disabled because the collection is expected to have already been
# restored or indexed explicitly.
DISABLE_AUTO_INGEST=true


# ==================================================
# 6. RAG pipeline
# ==================================================

PIPELINE_CHUNKING=clause

# STORAGE_BACKEND=qdrant_postgres makes the runtime use Qdrant retrieval.
# This value is retained for compatibility with the current pipeline config.
PIPELINE_SEARCH=faiss

# Enable the fine-tuned local cross-encoder reranker.
PIPELINE_RERANKING=cross_encoder

PIPELINE_CONTEXT_BUILDER=nested
PIPELINE_REWRITER=none

REWRITER_MODEL_PROVIDER=ollama
REWRITER_MODEL_NAME=qwen2.5:1.5b


# ==================================================
# 7. Fine-tuned local reranker
# ==================================================
# The stable selected symlink currently points to candidate-003-004.
# No external reranking API is used.

RERANKER_MODEL=/models/reranking/vietlaw-bge-reranker-v2-m3-finetuned/selected

RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_FAIL_OPEN=false
RERANKER_MAX_CANDIDATES=20

RETRIEVER_CANDIDATE_K=60

HYBRID_VECTOR_WEIGHT=0.5
HYBRID_BM25_WEIGHT=0.5


# ==================================================
# 8. Semantic cache
# ==================================================
# Keep disabled during initial embedding/reranker verification so every
# request passes through:
#
# local embedding -> local Qdrant -> local reranker
#
# Enable it only after the retrieval flow has been validated.

ENABLE_SEMANTIC_CACHE=false
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_COLLECTION=semantic_cache_bge_m3_ft_v1


# ==================================================
# 9. Inference strategy
# ==================================================
# local_first uses local Ollama first.
# Remote providers are used only if explicitly configured as fallbacks.

INFERENCE_STRATEGY=local_first