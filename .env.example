# VietLaw AI environment template
# Copy this file to .env, then adjust values for native or Docker execution.
# Do not commit the resulting .env file or real API keys.
# End-user BYOK provider keys are configured in the browser UI and sent only
# for the current request; they are not persisted by the backend.

# 1. Frontend/runtime URLs
APP_URL=
BACKEND_URL=http://localhost:8000
# Optional compatibility fallback used by a few frontend proxy routes.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# 2. Server-side provider defaults and fallbacks
# These keys are optional defaults/fallbacks. Deployed users should configure
# their own provider keys in the browser configuration screen.
# In remote_first mode, the backend does not fall back to local Ollama.
HUGGINGFACE_API_KEY=
GOOGLE_API_KEY=
ENABLE_GOOGLE_FALLBACK=false
GOOGLE_FALLBACK_MODEL=gemini-3.1-flash-lite
GOOGLE_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Evaluation-only key used by the Ragas evaluation script.
OPENAI_API_KEY=

# 3. Embeddings
# Deployed retrieval is fixed to HuggingFace BAAI/bge-m3 for corpus/query consistency.
# API mode works with the declared backend requirements and is recommended for
# native/deployed execution. Local mode requires sentence-transformers/PyTorch.
# If HuggingFace returns 401/500, the API reports a clear embedding error to the client.
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-m3
HUGGINGFACE_EMBEDDING_MODE=api
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_SLEEP_BETWEEN_BATCHES=5
EMBEDDING_RETRY_BASE_WAIT=15

# 4. Optional Ollama local development
# Ollama is used only with INFERENCE_STRATEGY=local_first.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_TIMEOUT=300

# 5. Storage
# Supported values: faiss, qdrant, qdrant_postgres, postgres, postgresql.
# qdrant_postgres is the persistent deployment path. Use faiss for a local
# run that does not require PostgreSQL/Qdrant (the committed FAISS index must
# be available under backend/vietlaw_faiss_index).
STORAGE_BACKEND=qdrant_postgres
# For a pure local FAISS run, use: STORAGE_BACKEND=faiss
# Native execution from the host:
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/vietlaw
QDRANT_URL=http://localhost:6333
# Docker Compose execution: use the service names instead:
# POSTGRES_DSN=postgresql://postgres:postgres@postgres:5432/vietlaw
# QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vietlaw_clauses
# Docker sets this to true for the backend service. Run the ingest service
# explicitly after PostgreSQL and Qdrant are ready.
DISABLE_AUTO_INGEST=false

# 6. RAG pipeline
PIPELINE_CHUNKING=clause
# This value is used only for the FAISS path. When STORAGE_BACKEND is
# qdrant_postgres/qdrant, the runtime creates QdrantSearcher and performs
# dense+sparse hybrid retrieval with manual RRF.
PIPELINE_SEARCH=faiss
# Supported values: none, cross_encoder, embedding_similarity.
# On remote_first deployments, cross_encoder uses embedding_similarity because
# HF Inference Providers do not reliably expose query/passage pair reranking.
PIPELINE_RERANKING=none
PIPELINE_CONTEXT_BUILDER=nested
PIPELINE_REWRITER=none
REWRITER_MODEL_PROVIDER=ollama
REWRITER_MODEL_NAME=qwen2.5:1.5b
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_CANDIDATES=20
RETRIEVER_CANDIDATE_K=60
# Reserved for experimental weighted-hybrid implementations; the current
# Qdrant path uses rank-based RRF and does not apply these weights.
HYBRID_VECTOR_WEIGHT=0.5
HYBRID_BM25_WEIGHT=0.5

# 7. Semantic cache
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_THRESHOLD=0.95

# 8. Inference fallback ordering
# Supported values: remote_first, local_first.
# remote_first uses only remote providers plus configured remote fallbacks.
# local_first uses Ollama first, then configured remote providers.
INFERENCE_STRATEGY=remote_first
