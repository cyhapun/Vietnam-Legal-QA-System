# Embedding provider: "huggingface" or "ollama"
EMBEDDING_PROVIDER=huggingface

# Hugging Face provider
HUGGINGFACE_API_KEY=
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-m3
# Chế độ chạy: "local" (tải model về máy - miễn phí, khuyên dùng) hoặc "api" (gọi HF Inference API)
HUGGINGFACE_EMBEDDING_MODE=local

# Ollama provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_TIMEOUT=300

# -------------------------------------------------------------
# 5. RAG Pipeline Configuration (Ablation Study)
# -------------------------------------------------------------
PIPELINE_CHUNKING=clause
PIPELINE_SEARCH=faiss
PIPELINE_RERANKING=none
PIPELINE_CONTEXT_BUILDER=nested
PIPELINE_REWRITER=none
REWRITER_MODEL_PROVIDER=ollama
REWRITER_MODEL_NAME=qwen2.5:1.5b

# Optional embedding throughput controls
EMBEDDING_BATCH_SIZE=32

# Storage backend selection
# Supported values: faiss, qdrant, qdrant_postgres, postgres, postgresql
# For local Docker-based development, use qdrant_postgres so PostgreSQL and Qdrant are used.
STORAGE_BACKEND=qdrant_postgres
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/vietlaw
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vietlaw_clauses

# -------------------------------------------------------------
# 6. Semantic Cache Configuration
# -------------------------------------------------------------
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_THRESHOLD=0.95

# -------------------------------------------------------------
# 7. Fallback Configuration
# -------------------------------------------------------------
# Strategy for hybrid fallback: "remote_first" or "local_first"
INFERENCE_STRATEGY=remote_first
