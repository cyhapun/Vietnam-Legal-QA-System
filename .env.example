# ==============================================================================
# VIETLAW AI - CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (ENVIRONMENT TEMPLATE)
# ==============================================================================
# Sao chép file này thành .env và điền các khóa API cần thiết:
#   cp .env.example .env
#
# Cấu hình tập trung cho toàn bộ hệ thống (FastAPI Backend & Next.js Frontend).
# Tối ưu mặc định cho môi trường chạy Local với Docker (PostgreSQL, Qdrant)
# và mô hình ngôn ngữ Google Gemini 3.1 Flash-Lite.

# ------------------------------------------------------------------------------
# 1. ĐỊA CHỈ DỊCH VỤ (HOST & PORTS)
# ------------------------------------------------------------------------------
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Hồ sơ vận hành:
# - local: Sử dụng model trọng số cục bộ (.safetensors) cho Embedding & Reranking.
# - serverless: Sử dụng API HuggingFace cho Embedding và deployment-safe reranker.
RUNTIME_PROFILE=local

# Chế độ lưu trữ hội thoại (Chat History Storage):
# - postgres: Lưu trữ tập trung tại cơ sở dữ liệu PostgreSQL.
# - browser: Lưu trữ riêng tư trên trình duyệt (LocalStorage).
CHAT_STORAGE_MODE=postgres
NEXT_PUBLIC_CHAT_STORAGE_MODE=postgres

# ------------------------------------------------------------------------------
# 2. KHÓA DỊCH VỤ SUY LUẬN (LLM PROVIDER - GOOGLE AI STUDIO)
# ------------------------------------------------------------------------------
# Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey
# Bắt buộc cấu hình để mô hình sinh câu trả lời và trích dẫn điều luật.
GOOGLE_API_KEY=

# Cố định mô hình suy luận Google AI Studio
GOOGLE_FALLBACK_MODEL=gemini-3.1-flash-lite
GOOGLE_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
ENABLE_GOOGLE_FALLBACK=false

# Chiến lược suy luận: remote_first (gọi trực tiếp Google Gemini API)
INFERENCE_STRATEGY=remote_first

# Khóa HuggingFace (chỉ cần khi HUGGINGFACE_EMBEDDING_MODE=api)
HUGGINGFACE_API_KEY=

# ------------------------------------------------------------------------------
# 3. CƠ SỞ DỮ LIỆU & VECTOR STORE (STORAGE BACKEND)
# ------------------------------------------------------------------------------
# Chế độ lưu trữ: qdrant_postgres (Vector Qdrant + Metadata PostgreSQL)
STORAGE_BACKEND=qdrant_postgres

# PostgreSQL DSN:
# - Chạy native từ máy host (Docker ánh xạ cổng 15432):
POSTGRES_DSN=postgresql://postgres:postgres@localhost:15432/vietlaw
# - Chạy nội bộ trong mạng Docker Compose (cổng 5432):
# POSTGRES_DSN=postgresql://postgres:postgres@postgres:5432/vietlaw

# Qdrant Vector DB:
# - Chạy native từ máy host:
QDRANT_URL=http://localhost:6333
# - Chạy nội bộ trong mạng Docker Compose:
# QDRANT_URL=http://qdrant:6333

QDRANT_API_KEY=
QDRANT_COLLECTION=vietlaw_clauses

# Khóa tự động ingest khi khởi động backend để tránh nạp trùng dữ liệu có sẵn
DISABLE_AUTO_INGEST=true
ENABLE_FAISS_FALLBACK=false

# ------------------------------------------------------------------------------
# 4. MÔ HÌNH EMBEDDING CỤC BỘ (VIETLAW BGE-M3 FINETUNED)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODE=local
HUGGINGFACE_EMBEDDING_MODEL=../models/embedding/vietlaw-bge-m3-finetuned/best
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024
EMBEDDING_NORMALIZE=true
LOCAL_MODELS_OFFLINE=true

# Tải trước (preload) và làm ấm (warm-up) model khi khởi động backend
LOCAL_MODELS_PRELOAD_ENABLED=true
LOCAL_MODELS_WARMUP_ENABLED=true

# Thông số batching khi thực hiện embedding
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_SLEEP_BETWEEN_BATCHES=5
EMBEDDING_RETRY_BASE_WAIT=15

# ------------------------------------------------------------------------------
# 5. MÔ HÌNH RERANKING CỤC BỘ (VIETLAW BGE-RERANKER-V2-M3 FINETUNED)
# ------------------------------------------------------------------------------
PIPELINE_RERANKING=cross_encoder
RERANKER_MODEL=../models/reranking/vietlaw-bge-reranker-v2-m3-finetuned/selected
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_FAIL_OPEN=false
RERANKER_MAX_CANDIDATES=10

# ------------------------------------------------------------------------------
# 6. THÔNG SỐ RAG PIPELINE & RETRIEVAL (SERVER-AUTHORITATIVE)
# ------------------------------------------------------------------------------
# Số tài liệu ứng viên lấy từ vector search trước khi đưa vào rerank
RETRIEVER_CANDIDATE_K=10

# Số tài liệu có điểm liên quan cao nhất sau khi rerank để nạp vào prompt
RETRIEVER_K=5

# Ngân sách token tối đa cho khối context căn cứ pháp lý
CONTEXT_TOKEN_BUDGET=6000

# Số lượng trích dẫn tối đa hiển thị cho người dùng
MAX_CITATIONS=5

# Số tin nhắn hội thoại gần nhất đưa vào prompt ngữ cảnh
HISTORY_MESSAGES=4

# Số subqueries tối đa khi phân tích câu hỏi
MAX_SUBQUERIES=3

# Cấu hình pipeline nội bộ
PIPELINE_CHUNKING=clause
PIPELINE_SEARCH=faiss
PIPELINE_CONTEXT_BUILDER=nested
PIPELINE_REWRITER=none

# Trọng số kết hợp vector và bm25 (khi dùng PIPELINE_SEARCH=hybrid)
HYBRID_VECTOR_WEIGHT=0.5
HYBRID_BM25_WEIGHT=0.5

# Cấu hình tham số sinh của LLM
LLM_MAX_NEW_TOKENS=1500
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=300

# ------------------------------------------------------------------------------
# 7. BỘ NHỚ ĐỆM NGỮ NGHĨA (SEMANTIC CACHE) & LOGGING
# ------------------------------------------------------------------------------
# Bật/tắt cache phản hồi theo độ tương đồng câu hỏi (tắt khi kiểm thử retrieval thuần)
ENABLE_SEMANTIC_CACHE=false
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_COLLECTION=semantic_cache_bge_m3_ft_v1

# Ghi log đo đạc thời gian chi tiết từng giai đoạn (Pipeline Timing)
PIPELINE_TIMING_ENABLED=false

# ------------------------------------------------------------------------------
# 8. CẤU HÌNH DỰ PHÒNG OLLAMA (TÙY CHỌN LOCAL LLM)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_TIMEOUT=300
REWRITER_MODEL_PROVIDER=ollama
REWRITER_MODEL_NAME=qwen2.5:1.5b
